generator client {
  provider        = "prisma-client-js"
  output          = "./generated/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                        @id @default(uuid())
  email                    String                        @unique
  password                 String
  name                     String
  phone                    String?
  role                     Role                          @default(CITIZEN)
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  region                   String?
  hasMobileApp             Boolean                       @default(false)
  isFieldActive            Boolean                       @default(false)
  lastCheckInTime          DateTime?
  nic                      String?                       @unique
  twoFactorEnabled         Boolean                       @default(false)
  twoFactorGracePeriodEnds DateTime?
  twoFactorSecret          String?
  profilePicture           String?
  currentSectorId          String?
  damageReports            DamageAssessment[]            @relation("DamageReports")
  donations                Donation[]
  familyMembers            FamilyMember[]
  helpRequests             HelpRequest[]
  reports                  IncidentReport[]
  localVerifier            LocalVerifier?
  locationLogs             LocationLog[]
  notifications            Notification[]
  supportRequests          PsychologicalSupportRequest[] @relation("SupportRequests")
  reliefTokens             ReliefToken[]                 @relation("ReliefTokens")
  verifications            ReportVerification[]
  safetyCheckIns           SafetyCheckIn[]
  createdTasks             Task[]                        @relation("CreatedTasks")
  assignedTasks            Task[]                        @relation("AssignedTasks")
  currentSector            Sector?                       @relation(fields: [currentSectorId], references: [id])
  sessionLogs              UserSessionLog[]
  volunteerProfile         VolunteerProfile?
}

model IncidentReport {
  id                 String               @id @default(uuid())
  title              String
  description        String
  location           String
  latitude           Float?
  longitude          Float?
  status             Status               @default(PENDING)
  severity           Severity             @default(MEDIUM)
  category           String
  images             String[]
  reporterId         String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  province           String?
  zoneId             String?
  zoneName           String?
  mlConfidence       Float?
  detectedLanguage   String?
  languageConfidence Float?
  translatedText     String?
  nlpEntities        Json?
  aar                AfterActionReport?
  damageAssessments  DamageAssessment[]
  history            IncidentHistory[]
  reporter           User                 @relation(fields: [reporterId], references: [id])
  verifications      ReportVerification[]
  tasks              Task[]
  verifierActions    VerifierAction[]
}

model Alert {
  id                   String         @id @default(uuid())
  title                String
  message              String
  type                 AlertType      @default(INFO)
  active               Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  latitudes            Float[]
  locations            String[]
  longitudes           Float[]
  acknowledgementRate  Float?
  channels             Json?
  scheduledTime        DateTime?
  translatedMsgSinhala String?
  translatedMsgTamil   String?
  targetSectors        String[]       @default([])
  broadcastRadiusKm    Float?
  notifiedCount        Int            @default(0)
  notifications        Notification[]
}

model Sector {
  id          String  @id
  name        String?
  type        String  @default("GRID")
  polygonData Json?
  district    String?
  province    String?
  users       User[]
}

model ReliefCamp {
  id               String                @id @default(uuid())
  name             String
  location         String
  latitude         Float?
  longitude        Float?
  currentOccupancy Int                   @default(0)
  totalCapacity    Int
  services         String[]
  status           String                @default("OPEN")
  waitTime         String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  inventory        CampInventory[]
  residents        CampResident[]
  schedules        CampSchedule[]
  transfersOut     CampTransferRequest[] @relation("TransfersOut")
  transfersIn      CampTransferRequest[] @relation("TransfersIn")
  donations        Donation[]
  referrals        HospitalReferral[]
}

model Resource {
  id        String   @id @default(uuid())
  type      String
  owner     String
  location  String
  capacity  String
  status    String   @default("AVAILABLE")
  contact   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id           String          @id @default(uuid())
  title        String
  description  String
  incidentId   String?
  assignedToId String?
  assignedById String?
  priority     Severity        @default(MEDIUM)
  status       Status          @default(PENDING)
  dueDate      DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  assignedBy   User?           @relation("CreatedTasks", fields: [assignedById], references: [id])
  assignedTo   User?           @relation("AssignedTasks", fields: [assignedToId], references: [id])
  incident     IncidentReport? @relation(fields: [incidentId], references: [id])
}

model VolunteerProfile {
  id              String               @id @default(uuid())
  userId          String               @unique
  createdAt       DateTime             @default(now())
  incidentsJoined Int                  @default(0)
  readinessScore  Float                @default(100.0)
  totalHours      Float                @default(0)
  updatedAt       DateTime             @updatedAt
  badges          VolunteerBadge[]
  checkIns        VolunteerCheckIn[]
  user            User                 @relation(fields: [userId], references: [id])
  skills          VolunteerSkill[]
  trainings       VolunteerTraining[]
  wellbeingLogs   VolunteerWellbeing[]
}

model HelpRequest {
  id                  String                  @id @default(uuid())
  userId              String?
  type                String
  description         String
  location            String
  latitude            Float?
  longitude           Float?
  priority            Severity                @default(MEDIUM)
  status              Status                  @default(PENDING)
  peopleCount         Int?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  assignedVolunteerId String?
  escalationLevel     String                  @default("NONE")
  phone               String?
  user                User?                   @relation(fields: [userId], references: [id])
  escalations         HelpRequestEscalation[]
  verifierActions     VerifierAction[]
}

model HelpRequestEscalation {
  id            String      @id @default(uuid())
  helpRequestId String
  level         String
  message       String
  triggeredAt   DateTime    @default(now())
  helpRequest   HelpRequest @relation(fields: [helpRequestId], references: [id])
}

model ReportVerification {
  id        String         @id @default(uuid())
  reportId  String
  userId    String
  status    String
  comment   String?
  createdAt DateTime       @default(now())
  report    IncidentReport @relation(fields: [reportId], references: [id])
  user      User           @relation(fields: [userId], references: [id])
}

model MissingPerson {
  id                  String   @id @default(uuid())
  name                String
  age                 Int?
  description         String
  lastSeen            String
  photo               String?
  reportedBy          String?
  status              String   @default("MISSING")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  nic                 String?
  contactName         String?
  contactPhone        String?
  gender              String?
  isUnidentified      Boolean  @default(false)
  reunificationNotes  String?
  reunificationStatus String   @default("NONE")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  alertId   String?
  title     String
  message   String
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  alert     Alert?    @relation(fields: [alertId], references: [id], onDelete: SetNull)
}

model MLLog {
  id           String   @id @default(uuid())
  incidentId   String?
  inputData    Json
  prediction   String
  confidence   Float?
  modelVersion String
  createdAt    DateTime @default(now())
}

model IncidentHistory {
  id         String         @id @default(uuid())
  incidentId String
  status     Status
  updatedBy  String
  note       String?
  createdAt  DateTime       @default(now())
  incident   IncidentReport @relation(fields: [incidentId], references: [id])
}

model ResourceRequestMatch {
  id         String   @id @default(uuid())
  requestId  String
  resourceId String
  matchScore Float
  status     String
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
}

model LocationLog {
  id        String   @id @default(uuid())
  userId    String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model ReliefToken {
  id                String             @id @default(uuid())
  code              String             @unique
  qrCodeData        String
  userId            String
  campId            String?
  status            TokenStatus        @default(ACTIVE)
  usageCount        Int                @default(0)
  maxUsage          Int                @default(1)
  issuedAt          DateTime           @default(now())
  expiresAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  categories        TokenCategory[]
  donorId           String?
  fraudRiskScore    Float              @default(0.0)
  householdId       String?
  isHouseholdBundle Boolean            @default(false)
  donor             DonorCampaign?     @relation(fields: [donorId], references: [id])
  user              User               @relation("ReliefTokens", fields: [userId], references: [id])
  claims            ReliefTokenClaim[]
}

model ReliefTokenClaim {
  id          String      @id @default(uuid())
  tokenId     String
  claimedAt   DateTime    @default(now())
  claimedBy   String
  itemType    String
  quantity    Int
  proofImage  String?
  campId      String?
  notes       String?
  locationLat Float?
  locationLng Float?
  token       ReliefToken @relation(fields: [tokenId], references: [id])
}

model DamageAssessment {
  id                           String          @id @default(uuid())
  reportedById                 String
  incidentId                   String?
  location                     String
  latitude                     Float?
  longitude                    Float?
  category                     DamageCategory
  structuralDamage             DamageLevel     @default(NONE)
  cropDamage                   DamageLevel     @default(NONE)
  utilityDamage                DamageLevel     @default(NONE)
  roadDamage                   DamageLevel     @default(NONE)
  affectedPersons              Int?
  estimatedLoss                Float?
  mediaUrls                    String[]
  status                       DamageStatus    @default(PENDING_REVIEW)
  notes                        String?
  verifiedById                 String?
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
  aiEstimatedCost              Float?
  aiEstimatedDamage            String?
  compensationEligibilityScore Float?
  compensationEligible         Boolean         @default(false)
  familyVulnerabilityScore     Int?
  incomeBracket                String?
  polygonData                  Json?
  propertyOwnershipStatus      String?
  reviewerNotes                String?
  incident                     IncidentReport? @relation(fields: [incidentId], references: [id])
  reportedBy                   User            @relation("DamageReports", fields: [reportedById], references: [id])
}

model LocalVerifier {
  id                 String           @id @default(uuid())
  userId             String           @unique
  verifierRole       VerifierRole
  jurisdiction       String
  orgName            String?
  isApproved         Boolean          @default(false)
  approvedAt         DateTime?
  approvedById       String?
  verificationsCount Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id])
  actions            VerifierAction[]
}

model VerifierAction {
  id            String             @id @default(uuid())
  verifierId    String
  incidentId    String?
  helpRequestId String?
  result        VerificationResult
  comment       String?
  createdAt     DateTime           @default(now())
  helpRequest   HelpRequest?       @relation(fields: [helpRequestId], references: [id])
  incident      IncidentReport?    @relation(fields: [incidentId], references: [id])
  verifier      LocalVerifier      @relation(fields: [verifierId], references: [id])
}

model PsychologicalSupportRequest {
  id              String         @id @default(uuid())
  userId          String
  type            SupportType    @default(GENERAL)
  description     String?
  urgency         SupportUrgency @default(MEDIUM)
  status          SupportStatus  @default(PENDING)
  anonymous       Boolean        @default(false)
  location        String?
  affectedCount   Int?
  assignedToId    String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  checkInStatus   String?        @default("PENDING")
  nextCheckInDate DateTime?
  user            User           @relation("SupportRequests", fields: [userId], references: [id])
}

model ThreatForecast {
  id           String   @id @default(uuid())
  district     String
  threatType   String
  confidence   Float
  severity     Severity @default(MEDIUM)
  forecastTime DateTime
  createdAt    DateTime @default(now())
}

model ShiftHandover {
  id                String   @id @default(uuid())
  shiftTime         DateTime
  incidentsOpened   Int      @default(0)
  incidentsClosed   Int      @default(0)
  resourcesDeployed Int      @default(0)
  volunteersActive  Int      @default(0)
  criticalItems     String?
  createdAt         DateTime @default(now())
}

model EvacuationRoute {
  id          String   @id @default(uuid())
  name        String
  type        String
  coordinates Json
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VolunteerLocation {
  id          String   @id @default(uuid())
  volunteerId String
  latitude    Float
  longitude   Float
  status      String   @default("ACTIVE")
  skill       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ThreatProjection {
  id            String   @id @default(uuid())
  name          String
  type          String
  polygonCoords Json
  riskLevel     Severity @default(HIGH)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AfterActionReport {
  id             String         @id @default(uuid())
  incidentId     String         @unique
  timeline       Json
  resourcesUsed  Json
  costEstimate   Float
  peopleAffected Int
  resolutionTime Int
  lessonsLearned String?
  createdAt      DateTime       @default(now())
  incident       IncidentReport @relation(fields: [incidentId], references: [id])
}

model KPIBenchmark {
  id                String   @id @default(uuid())
  month             String
  targetAvgResponse Int
  targetOccupancy   Float
  targetVolunteer   Float
  createdAt         DateTime @default(now())
}

model ResourceCost {
  id           String                @id @default(uuid())
  resourceType String                @unique
  unitCost     Float
  unitType     String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  expenditures ResourceExpenditure[]
}

model DisasterBudget {
  id              String                @id @default(uuid())
  eventName       String
  allocatedBudget Float
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  expenditures    ResourceExpenditure[]
}

model ResourceExpenditure {
  id             String         @id @default(uuid())
  resourceCostId String
  quantity       Float
  totalCost      Float
  budgetId       String
  createdAt      DateTime       @default(now())
  budget         DisasterBudget @relation(fields: [budgetId], references: [id])
  resourceCost   ResourceCost   @relation(fields: [resourceCostId], references: [id])
}

model RolePermission {
  id        String   @id @default(uuid())
  role      Role
  module    String
  canView   Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model UserSessionLog {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String?
  device    String?
  location  String?
  loginTime DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model CampResident {
  id           String     @id @default(uuid())
  campId       String
  name         String
  nic          String?
  familySize   Int        @default(1)
  checkInTime  DateTime   @default(now())
  checkOutTime DateTime?
  status       String     @default("ACTIVE")
  camp         ReliefCamp @relation(fields: [campId], references: [id])
}

model CampInventory {
  id          String            @id @default(uuid())
  campId      String
  itemType    InventoryItemType
  quantity    Int
  threshold   Int
  lastUpdated DateTime          @default(now())
  camp        ReliefCamp        @relation(fields: [campId], references: [id])
}

model CampSchedule {
  id           String     @id @default(uuid())
  campId       String
  activityName String
  startTime    String
  endTime      String
  type         String
  camp         ReliefCamp @relation(fields: [campId], references: [id])
}

model HospitalReferral {
  id                String         @id @default(uuid())
  campId            String
  patientName       String
  conditionSeverity Severity       @default(MEDIUM)
  hospitalAssigned  String
  transportMethod   String?
  outcome           String?
  status            ReferralStatus @default(PENDING)
  createdAt         DateTime       @default(now())
  camp              ReliefCamp     @relation(fields: [campId], references: [id])
}

model CampTransferRequest {
  id          String     @id @default(uuid())
  fromCampId  String
  toCampId    String
  peopleCount Int
  status      String     @default("PENDING")
  requestDate DateTime   @default(now())
  fromCamp    ReliefCamp @relation("TransfersOut", fields: [fromCampId], references: [id])
  toCamp      ReliefCamp @relation("TransfersIn", fields: [toCampId], references: [id])
}

model DonorCampaign {
  id                 String          @id @default(uuid())
  donorName          String
  contributionAmount Float
  targetCategories   TokenCategory[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  tokens             ReliefToken[]
}

model VolunteerSkill {
  id               String           @id @default(uuid())
  volunteerId      String
  skillName        String
  certificationUrl String?
  volunteer        VolunteerProfile @relation(fields: [volunteerId], references: [id])
}

model VolunteerTraining {
  id           String           @id @default(uuid())
  volunteerId  String
  trainingName String
  completedAt  DateTime
  expiresAt    DateTime?
  volunteer    VolunteerProfile @relation(fields: [volunteerId], references: [id])
}

model VolunteerCheckIn {
  id           String           @id @default(uuid())
  volunteerId  String
  checkInTime  DateTime         @default(now())
  checkOutTime DateTime?
  latitude     Float
  longitude    Float
  zone         String?
  activeHours  Float            @default(0)
  volunteer    VolunteerProfile @relation(fields: [volunteerId], references: [id])
}

model VolunteerWellbeing {
  id             String           @id @default(uuid())
  volunteerId    String
  recordedAt     DateTime         @default(now())
  physicalRating Int
  mentalRating   Int
  needsResources Boolean          @default(false)
  distressFlag   Boolean          @default(false)
  volunteer      VolunteerProfile @relation(fields: [volunteerId], references: [id])
}

model VolunteerBadge {
  id          String           @id @default(uuid())
  volunteerId String
  badgeType   String
  earnedAt    DateTime         @default(now())
  volunteer   VolunteerProfile @relation(fields: [volunteerId], references: [id])
}

model ChatSession {
  id          String        @id @default(uuid())
  requestId   String
  counselorId String?
  userId      String        @default("anonymous")
  status      String        @default("WAITING")
  startedAt   DateTime      @default(now())
  endedAt     DateTime?
  moodAfter   String?
  messages    ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  senderId  String
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id])
}

model GroupTherapySession {
  id              String                    @id @default(uuid())
  title           String
  description     String
  campId          String?
  counselorId     String
  scheduledFor    DateTime
  maxParticipants Int                       @default(20)
  status          String                    @default("SCHEDULED")
  participants    GroupTherapyParticipant[]
}

model Donation {
  id               String         @id @default(uuid())
  donorId          String?
  donorName        String
  type             DonationType
  amount           Float?
  itemsDescription String?
  transactionId    String?
  paymentGateway   String?
  transactionDate  DateTime?
  status           DonationStatus @default(PENDING)
  campId           String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  camp             ReliefCamp?    @relation(fields: [campId], references: [id])
  donor            User?          @relation(fields: [donorId], references: [id])
}

model SafetyCheckIn {
  id        String       @id @default(uuid())
  userId    String
  status    SafetyStatus
  message   String?
  latitude  Float?
  longitude Float?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id])
}

model FamilyMember {
  id            String       @id @default(uuid())
  primaryUserId String
  name          String
  relation      String
  status        SafetyStatus
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  primaryUser   User         @relation(fields: [primaryUserId], references: [id])
}

model GroupTherapyParticipant {
  id               String              @id @default(uuid())
  sessionId        String
  userId           String
  attendanceStatus String              @default("REGISTERED")
  notes            String?
  session          GroupTherapySession @relation(fields: [sessionId], references: [id])
}

model MentalHealthGuide {
  id                 String   @id @default(uuid())
  title              String
  content            String
  tags               String
  isOfflineAvailable Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model RainfallReading {
  id                String         @id @default(uuid())
  stationId         String
  stationName       String
  district          String
  province          String
  latitude          Float
  longitude         Float
  rainfallMmPerHour Float
  cumulativeRain24h Float
  cumulativeRain72h Float
  riskLevel         WaterRiskLevel
  recordedAt        DateTime
  fetchedAt         DateTime
  source            String
}

model RiverWaterLevel {
  id                 String      @id @default(uuid())
  gaugeId            String
  riverName          String
  stationName        String
  district           String
  latitude           Float
  longitude          Float
  waterLevelMetres   Float
  flowRateCumecs     Float
  alertLevel         Float
  minorFloodLevel    Float
  majorFloodLevel    Float
  status             RiverStatus
  changeFromLastHour Float
  trend              WaterTrend
  recordedAt         DateTime
  fetchedAt          DateTime
  source             String
}

model DownstreamMapping {
  id              String   @id @default(uuid())
  gaugeId         String   @unique
  riverName       String
  stationName     String
  targetDistricts String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum Role {
  CITIZEN
  VOLUNTEER
  ADMIN
  DMC_OFFICER
  FIELD_RESPONDER
}

enum Status {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  EN_ROUTE
  ON_SITE
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertType {
  INFO
  WARNING
  EMERGENCY
}

enum TokenStatus {
  ACTIVE
  PARTIALLY_USED
  FULLY_USED
  EXPIRED
  REVOKED
}

enum DamageCategory {
  RESIDENTIAL
  AGRICULTURAL
  INFRASTRUCTURE
  COMMERCIAL
  UTILITY
  OTHER
}

enum DamageLevel {
  NONE
  MINOR
  MODERATE
  MAJOR
  TOTAL_LOSS
}

enum DamageStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
  SENIOR_REVIEW
  APPROVED
}

enum VerifierRole {
  GRAMA_NILADHARI
  VILLAGE_OFFICER
  COMMUNITY_LEADER
  NGO_OFFICER
  LOCAL_AUTHORITY
}

enum VerificationResult {
  CONFIRMED
  REJECTED
  NEEDS_INVESTIGATION
}

enum SupportType {
  COUNSELING
  CHILD_SUPPORT
  TRAUMA_CARE
  GRIEF_SUPPORT
  GENERAL
}

enum SupportUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SupportStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum InventoryItemType {
  FOOD
  WATER
  MEDICAL
  BLANKETS
  HYGIENE
}

enum ReferralStatus {
  PENDING
  IN_TRANSIT
  ADMITTED
  DISCHARGED
}

enum TokenCategory {
  MEDICAL
  FOOD
  CLOTHING
  SHELTER
  TRANSPORT
  EDUCATION
  MENTAL_HEALTH
}

enum DonationType {
  MONETARY
  MATERIAL
}

enum DonationStatus {
  PENDING
  RECEIVED
  ALLOCATED
}

enum SafetyStatus {
  SAFE
  NEEDS_HELP
  UNKNOWN
  INJURED
  EVACUATED
  TRAPPED
  SHELTERED
}

enum WaterRiskLevel {
  NORMAL
  WATCH
  WARNING
  DANGER
}

enum RiverStatus {
  NORMAL
  ALERT
  MINOR_FLOOD
  MAJOR_FLOOD
}

enum WaterTrend {
  RISING
  FALLING
  STABLE
}

model PublicSafePlace {
  id         String   @id @default(uuid())
  name       String
  type       String
  district   String
  province   String
  latitude   Float
  longitude  Float
  capacity   Int?
  address    String?
  phone      String?
  isVerified Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AuthorityContact {
  id        String   @id @default(uuid())
  district  String
  role      String
  name      String
  phone     String
  phone2    String?
  email     String?
  sector    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
