<mxfile host="app.diagrams.net" version="24.7.5"><diagram name="Fig 5.2 Trilingual Intake Pipeline" id="fig52pipe"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Figure 5.2 — Trilingual Intake Pipeline (runs automatically on every incident report)" style="text;html=1;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1880" height="24" as="geometry"/></mxCell><mxCell id="si" value="Sinhala text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="150" height="40" as="geometry"/></mxCell><mxCell id="ta" value="Tamil text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="150" height="40" as="geometry"/></mxCell><mxCell id="en" value="English text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="195" width="150" height="40" as="geometry"/></mxCell><mxCell id="d1" value="1 · detect_language()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Unicode-script check → Sinhala / Tamil / English word-list → statistical library (langdetect / langid)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="210" height="110" as="geometry"/></mxCell><mxCell id="d2" value="2 · translate_to_english()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;library NMT — only when language ≠ English&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="510" y="110" width="210" height="110" as="geometry"/></mxCell><mxCell id="d3" value="3 · extract_entities()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;spaCy NER trained on auto-annotated DMC reports → { LOC, INCIDENT, COUNT, DATE, DAMAGE }&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="770" y="110" width="220" height="110" as="geometry"/></mxCell><mxCell id="d4" value="4 · build_feature_vector()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;12-dim: affected population, hazard type, vulnerability flags&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="770" y="320" width="220" height="100" as="geometry"/></mxCell><mxCell id="d5" value="5 · multitask classification&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;XGBoost predict_proba → temperature-scale → &lt;b&gt;severity&lt;/b&gt; + disaster type + urgency + resource-need signals&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1040" y="315" width="250" height="120" as="geometry"/></mxCell><mxCell id="ph" value="attached photo  (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1050" y="150" width="240" height="44" as="geometry"/></mxCell><mxCell id="d6" value="6 · image_encoder()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;CLIP-style embedding — only when a photo is attached (pre-trained library)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1050" y="205" width="240" height="80" as="geometry"/></mxCell><mxCell id="d7" value="7 · multimodal_fusion()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;confidence-weighted fusion of text + image + location + time&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1340" y="300" width="230" height="130" as="geometry"/></mxCell><mxCell id="out" value="RETURN { severity, confidence, detected_language, translated_text, entities }&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;written back to IncidentReport; all downstream logic uses this normalised output&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1620" y="315" width="300" height="110" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="si" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="ta" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="en" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="detected language" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="English text" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="[ English — skip translation ]" style="endArrow=block;html=1;fontSize=9;dashed=1;" edge="1" parent="1" source="d1" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="entities" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="feature vector" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="ph" target="d6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="severity + signals" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d5" target="d7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="[ if photo attached ] image embedding" style="endArrow=block;html=1;fontSize=9;dashed=1;" edge="1" parent="1" source="d6" target="d7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d7" target="out"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1" value="Every input language is normalised to English + structured entities before any human sees it — this removes the &quot;read three languages under pressure&quot; burden from DMC officers. Steps 2, 6 and 7 are conditional (translation skipped for English; image encoding + fusion run only when a photo is attached)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="250" y="250" width="700" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>