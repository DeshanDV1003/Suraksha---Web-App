<mxfile host="app.diagrams.net" version="24.7.5"><diagram name="Fig 5.3 Framework Workflow" id="fig53"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Figure 5.3 — Block Diagram of the Framework Workflow: End-to-End Data Flow" style="text;html=1;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1420" height="26" as="geometry"/></mxCell><mxCell id="n1" value="Citizen submits report&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Si/Ta/En + photo + GPS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="150" height="70" as="geometry"/></mxCell><mxCell id="n2" value="useOfflineSubmit hook&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Promise.race vs 8 s timeout&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="240" y="90" width="150" height="70" as="geometry"/></mxCell><mxCell id="n3" value="SQLite sync_queue&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;queue on 5xx / timeout / offline; FIFO; retry ≤ 5&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="240" y="210" width="150" height="70" as="geometry"/></mxCell><mxCell id="n4" value="Backend /api/incidents&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;requireFields · geocode (Nominatim) · findZoneForCoordinates (turf)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="430" y="90" width="170" height="70" as="geometry"/></mxCell><mxCell id="n5" value="INSERT IncidentReport&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;severity = MEDIUM default&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="150" height="70" as="geometry"/></mxCell><mxCell id="n6" value="ML /process-report&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;detect_language → translate → spaCy NER → build_feature_vector → XGBoost predict_proba → temperature scale&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="830" y="90" width="190" height="70" as="geometry"/></mxCell><mxCell id="n7" value="Duplicate detection&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;weighted score (loc 40 + cat 30 + time 20 + NLP 10) ≥ 50 → link&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="830" y="220" width="190" height="70" as="geometry"/></mxCell><mxCell id="n8" value="UPDATE IncidentReport&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;severity, confidence, entities, language; write MLLog&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="1060" y="90" width="150" height="70" as="geometry"/></mxCell><mxCell id="n9" value="Uncertainty routing&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;conf ≥ ~0.73 → auto-accept; else → human-review queue + notify officers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1250" y="90" width="180" height="70" as="geometry"/></mxCell><mxCell id="n10" value="DMC officer review&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;confirm / correct severity → active-learning pool&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1250" y="360" width="180" height="70" as="geometry"/></mxCell><mxCell id="n11" value="Officer authors / confirms alert&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;INSERT Alert · translate Si/Ta · target downstream districts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1030" y="360" width="170" height="70" as="geometry"/></mxCell><mxCell id="n12" value="Multi-channel dispatch&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Notification rows · Expo push · Twilio SMS · Nodemailer · Telegram · Socket.IO new-alert&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="800" y="360" width="170" height="70" as="geometry"/></mxCell><mxCell id="n13" value="Citizen device&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;isAlertNearby() filter → local notification&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="590" y="360" width="150" height="70" as="geometry"/></mxCell><mxCell id="n14" value="System scheduler&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;cron 0 * * * *&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="150" height="70" as="geometry"/></mxCell><mxCell id="n15" value="Ingest river + rainfall&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;RiverWaterLevel · Open-Meteo&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="240" y="360" width="160" height="70" as="geometry"/></mxCell><mxCell id="n16" value="LSTM /predict-water-level&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;per gauge T+1h/T+2h + confidence + alert_level; UPSERT WaterLevelPrediction (cache)&lt;/font&gt;" style="rou