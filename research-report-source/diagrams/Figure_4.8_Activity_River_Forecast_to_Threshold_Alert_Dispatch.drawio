<mxfile host="app.diagrams.net" version="24.7.5"><diagram name="Fig 4.8 Activity AD-3" id="fig48ad"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1550" pageHeight="1680" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Figure 4.8 — Activity Diagram: Automated River Forecast → Threshold Alert Dispatch (hourly)" style="text;html=1;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1470" height="24" as="geometry"/></mxCell><mxCell id="ln0" value="System Scheduler" style="swimlane;html=1;startSize=28;horizontal=1;fillColor=none;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="245" height="1610" as="geometry"/></mxCell><mxCell id="ln1" value="Backend" style="swimlane;html=1;startSize=28;horizontal=1;fillColor=none;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="285" y="44" width="245" height="1610" as="geometry"/></mxCell><mxCell id="ln2" value="ML Service" style="swimlane;html=1;startSize=28;horizontal=1;fillColor=none;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530" y="44" width="245" height="1610" as="geometry"/></mxCell><mxCell id="ln3" value="PostgreSQL" style="swimlane;html=1;startSize=28;horizontal=1;fillColor=none;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="775" y="44" width="245" height="1610" as="geometry"/></mxCell><mxCell id="ln4" value="External Channels" style="swimlane;html=1;startSize=28;horizontal=1;fillColor=none;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1020" y="44" width="245" height="1610" as="geometry"/></mxCell><mxCell id="ln5" value="Citizen" style="swimlane;html=1;startSize=28;horizontal=1;fillColor=none;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1265" y="44" width="245" height="1610" as="geometry"/></mxCell><mxCell id="st" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="57.5" y="80" width="210" height="28" as="geometry"/></mxCell><mxCell id="a1" value="cron  0 * * * *  — begin hourly cycle" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="57.5" y="135" width="210" height="56" as="geometry"/></mxCell><mxCell id="a2" value="simulateDataFetch() — pull / refresh river-gauge readings" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="302.5" y="135" width="210" height="56" as="geometry"/></mxCell><mxCell id="a3" value="INSERT RiverWaterLevel[]  (latest readings)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="792.5" y="135" width="210" height="56" as="geometry"/></mxCell><mxCell id="a4" value="evaluateThresholdsAndAlerts() — raw-reading breaches (rate-limited via RainfallAlertLog)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="302.5" y="235" width="210" height="60" as="geometry"/></mxCell><mxCell id="a5" value="runPredictionsForAllGauges() — SELECT DISTINCT active gauges" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="302.5" y="330" width="210" height="56" as="geometry"/></mxCell><mxCell id="loop" value="loop  [ for each gauge · 500 ms stagger ]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;fontStyle=2;fontSize=10;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="273" y="430" width="1249" height="1080" as="geometry"/></mxCell><mxCell id="g1" value="Fetch last ≤ 12 readings + matching rainfall; build the 7-feature sequence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="302.5" y="470" width="210" height="58" as="geometry"/></mxCell><mxCell id="d1" value="≥ 3 readings for this gauge?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="305" y="560" width="205" height="92" as="geometry"/></mxCell><mxCell id="g2" value="POST ML /predict-water-level  { sequence, gauge thresholds }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="302.5" y="690" width="210" height="56" as="geometry"/></mxCell><mxCell id="g3" value="LSTM forward pass (or rule-based fallback) → { predicted_t1_m, predicted_t2_m, confidence, alert_level, reason }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="547.5" y="690" width="210" height="80" as="geometry"/></mxCell><mxCell id="g4" value="UPSERT WaterLevelPrediction (gaugeId unique — the cache row served to GET /api/water/predictions)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="792.5" y="700" width="210" height="72" as="geometry"/></mxCell><mxCell id="d2" value="confidence ≥ 0.75  AND  threat within 2 h  AND  alert_level ≠ NONE ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="305" y="805" width="205" height="104" as="geometry"/></mxCell><mxCell id="d3" value="Same (gauge, alert_level) already alerted in the last 30 min?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="305" y="945" width="205" height="100" as="geometry"/></mxCell><mxCell id="a6" value="DownstreamMapping[gauge] → target districts (fallback [gauge.district]); fetch nearby PublicSafePlace safe zones" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" paren