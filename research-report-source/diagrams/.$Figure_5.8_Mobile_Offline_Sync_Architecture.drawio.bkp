<mxfile host="app.diagrams.net" version="24.7.5"><diagram name="Fig 5.8 Mobile Offline Sync (simple)" id="fig58simple"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Figure 5.8 — Mobile Offline-Sync Architecture" style="text;html=1;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1360" height="24" as="geometry"/></mxCell><mxCell id="scr" value="25 screens
in the app" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="190" height="110" as="geometry"/></mxCell><mxCell id="hook" value="Every 'Save' button tries
the internet first
(gives up after 8 seconds)" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="140" width="230" height="130" as="geometry"/></mxCell><mxCell id="q" value="A list on the phone of
things still waiting
to be sent" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="120" width="250" height="170" as="geometry"/></mxCell><mxCell id="cache" value="A copy of useful data kept
on the phone, so screens still
work without the internet" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="340" width="250" height="110" as="geometry"/></mxCell><mxCell id="sync" value="Sends everything on the list,
oldest first — tries again
if it fails (up to 5 times)" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="120" width="250" height="150" as="geometry"/></mxCell><mxCell id="api" value="The server" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="350" width="250" height="80" as="geometry"/></mxCell><mxCell id="nm" value="Watches for the
internet coming back" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="540" width="240" height="80" as="geometry"/></mxCell><mxCell id="bg" value="Also checks every
so often, even if the
app is closed" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="540" width="240" height="80" as="geometry"/></mxCell><mxCell id="fg" value="...or when you
open the app again" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="540" width="180" height="80" as="geometry"/></mxCell><mxCell id="mo1" value="save" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;html=1;endArrow=block;endFill=1;rounded=0;curved=1;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="scr" target="hook"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mo2" value="no internet →
save for later" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;html=1;endArrow=block;endFill=1;rounded=0;curved=1;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="hook" target="q"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mo3" value="bad data → show error
(not saved for later)" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;html=1;endArrow=block;endFill=1;rounded=0;curved=1;strokeWidth=2;fontSize=9;dashed=1;" edge="1" parent="1" source="hook" target="scr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mo4" value="oldest first" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;html=1;endArrow=block;endFill=1;rounded=0;curved=1;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="q" target="sync"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mo5" value="mark done /
try again" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;html=1;endArrow=block;endFill=1;rounded=0;curved=1;strokeWidth=2;fontSize=9;dashed=1;" edge="1" parent="1" source="sync" target="q"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mo6" value="send it" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;html=1;endArrow=block;endFill=1;rounded=0;curved=1;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="sync" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mo7" value="reply" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;html=1;endArrow=block;endFill=1;rounded=0;curved=1;strokeWidth=2;fontSize=9;dashed=1;" edge="1" parent="1" source="api" target="sync"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mo8" value="go!" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;html=1;endArrow=block;endFill=1;rounded=0;curved=1;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="nm" target="sync"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mo9" value="go!" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;html=1;endArrow=block;endFill=1;rounded=0;curved=1;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="bg" target="sync"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mo10" value="go!" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;html=1;endArrow=block;endFill=1;rounded=0;curved=1;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="fg" target="sync"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mo11" value="read while offline" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;html=1;endArrow=block;endFill=1;rounded=0;curved=1;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="cache" target="scr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1" value="If it's bad data, we tell you right away — there's no point saving it. If it's just no internet
or a slow server, we save it and try again later." style="text;html=1;fontFamily=Comic Sans MS;fontStyle=2;fontSize=10;align=left;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="510" height="60" as="geometry"/></mxCell><mxCell id="n2" value="12 kinds of thing can be saved this way — incident reports, SOS, help requests, damage
reports, task updates, relief tokens, family updates, check-ins, wellbeing logs, profile changes." style="text;html=1;fontFamily=Comic Sans MS;fontStyle=2;fontSize=10;align=left;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="510" height="60" as="geometry"/></mxCell><mxCell id="n3" value="Tested under 6 different ways the connection can fail: nothing was lost.
One known issue: retrying can occasionally save the same thing twice — a fix is planned." style="text;html=1;fontFamily=Comic Sans MS;fontStyle=2;fontSize=10;align=left;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="930" y="650" width="470" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>