<mxfile host="app.diagrams.net" version="24.7.5"><diagram name="Fig 5.1 Mobile Offline Sync" id="fig51mob"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Figure 5.1 — Mobile Offline-Sync Architecture" style="text;html=1;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1360" height="24" as="geometry"/></mxCell><mxCell id="scr" value="25 mobile screens&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;role-adaptive bottom tabs · citizen / volunteer / field responder&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="190" height="110" as="geometry"/></mxCell><mxCell id="hook" value="useOfflineSubmit hook&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;wraps every write operation · tries the network first with an 8 s timeout&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="290" y="140" width="230" height="130" as="geometry"/></mxCell><mxCell id="q" value="SQLite  (expo-sqlite, WAL)&lt;br&gt;&lt;br&gt;&lt;b&gt;sync_queue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;outbound mutations · 12 types · payload (JSON) · status · attempts · created_at&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="600" y="120" width="250" height="170" as="geometry"/></mxCell><mxCell id="cache" value="Read-only cache tables&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;incidents_cache · alerts_cache · relief_camps_cache · (seeded) emergency_numbers_cache · first_aid_cache&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="600" y="340" width="250" height="110" as="geometry"/></mxCell><mxCell id="sync" value="syncService.syncPendingItems()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;strict FIFO drain (ORDER BY created_at) · marks each item synced / failed · retries a failed item up to 5 times, then gives up · 300 ms inter-request gap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="930" y="120" width="250" height="150" as="geometry"/></mxCell><mxCell id="api" value="Backend API&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;POST SYNC_HANDLERS[type].endpoint  { X-Offline-Sync, X-Original-Timestamp }&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="930" y="350" width="250" height="80" as="geometry"/></mxCell><mxCell id="nm" value="networkMonitor&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;polls device network state every 8 s · triggers an immediate sync on reconnection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="600" y="540" width="240" height="80" as="geometry"/></mxCell><mxCell id="bg" value="backgroundSync&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;registered with Expo background-fetch · drains the queue periodically even when the app is closed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="870" y="540" width="240" height="80" as="geometry"/></mxCell><mxCell id="fg" value="app returns to foreground" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1150" y="540" width="180" height="80" as="geometry"/></mxCell><mxCell id="e1" value="submit(payload)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="scr" target="hook"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="5xx / timeout / offline → enqueue (retryable)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="hook" target="q"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="4xx → surface error, NOT queued" style="endArrow=block;html=1;fontSize=9;dashed=1;" edge="1" parent="1" source="hook" target="scr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="SELECT pending  (FIFO)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="q" target="sync"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="markSynced / markFailed (attempts++)" style="endArrow=open;dashed=1;html=1;fontSize=9;" edge="1" parent="1" source="sync" target="q"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="replay in order" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="sync" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="201 / 4xx / 5xx" style="endArrow=open;dashed=1;html=1;fontSize=9;" edge="1" parent="1" source="api" target="sync"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="nm" target="sync"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="bg" target="sync"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="fg" target="sync"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="offline reads" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="cache" target="scr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1" value="A client error (4xx) is treated as permanent — shown to the user, never queued (bad data will not sync later). A server error (5xx), an 8 s timeout, or a network failure is treated as retryable." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="510" height="80" as="geometry"/></mxCell><mxCell id="n2" value="12 queued mutation types cover every citizen / volunteer write: incident report, SOS, help request, damage assessment, task-status update, relief-token claim, family-member add / update, safety check-in, volunteer check-in, wellbeing log, profile update." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="510" height="90" as="geometry"/></mxCell><mxCell id="n3" value="Measured under 6 connectivity-failure conditions (§6.6): 0% data loss. Known gap: a retried item the server already accepted is written twice — future work: client idempotency key + server-side upsert (TC-M-030)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="930" y="470" width="250" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>