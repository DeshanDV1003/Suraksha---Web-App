        <mxCell id="d1" parent="1" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=11;" value="1. Work out what language it is written in" vertex="1">
          <mxGeometry height="110" width="210" x="250" y="110" as="geometry" />
        </mxCell>
        <mxCell id="d2" parent="1" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=11;" value="2. Translate it into English (only if it isn&#39;t already)" vertex="1">
          <mxGeometry height="110" width="210" x="510" y="110" as="geometry" />
        </mxCell>
        <mxCell id="d3" parent="1" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=11;" value="3. Pick out the key facts — place, what happened, how many people, when, how bad the damage is" vertex="1">
          <mxGeometry height="110" width="220" x="790" y="110" as="geometry" />
        </mxCell>
        <mxCell id="d4" parent="1" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=11;" value="4. Turn those facts into numbers the AI can use" vertex="1">
          <mxGeometry height="100" width="220" x="770" y="320" as="geometry" />
        </mxCell>
        <mxCell id="d5" parent="1" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=11;" value="5. AI guesses: how severe, what kind of disaster, how urgent, what is needed" vertex="1">
          <mxGeometry height="120" width="250" x="1040" y="315" as="geometry" />
        </mxCell>
        <mxCell id="ph" parent="1" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=11;" value="a photo, if one was attached" vertex="1">
          <mxGeometry height="44" width="240" x="1050" y="150" as="geometry" />
        </mxCell>
        <mxCell id="d6" parent="1" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=11;" value="6. Turn the photo into something the AI can compare (only if there is one)" vertex="1">
          <mxGeometry height="80" width="240" x="1050" y="205" as="geometry" />
