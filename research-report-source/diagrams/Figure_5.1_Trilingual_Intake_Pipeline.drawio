        <mxCell id="t" parent="1" style="text;html=1;fontStyle=1;fontSize=14;align=left;" value="Figure 5.1 — Trilingual Intake Pipeline (runs automatically on every incident report)" vertex="1">
          <mxGeometry height="24" width="1880" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="si" parent="1" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=11;" value="Sinhala text" vertex="1">
