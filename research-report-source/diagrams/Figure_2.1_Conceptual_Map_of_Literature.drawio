<mxfile host="app.diagrams.net" version="24.7.5"><diagram name="Fig 2.1 Conceptual Map" id="fig21"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Figure 2.1 — Conceptual Map of the Literature" style="text;html=1;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1220" height="26" as="geometry"/></mxCell><mxCell id="ax" value="" style="endArrow=classic;html=1;fontSize=10;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="430" as="sourcePoint"/><mxPoint x="1180" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ay" value="" style="endArrow=classic;html=1;fontSize=10;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="780" as="sourcePoint"/><mxPoint x="650" y="70" as="targetPoint"/></mxGeometry></mxCell><mxCell id="axl" value="Theoretical frameworks  →  Applied technical frameworks" style="text;html=1;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="438" width="1000" height="20" as="geometry"/></mxCell><mxCell id="ayl" value="Sri Lankan operational context  ↑  Global context" style="text;html=1;fontSize=10;fontStyle=2;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="700" height="20" as="geometry"/></mxCell><mxCell id="ctr" value="AI-enabled multi-stakeholder&lt;br&gt;disaster coordination&lt;br&gt;&lt;b&gt;(Suraksha's contribution)&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="380" width="260" height="100" as="geometry"/></mxCell><mxCell id="th1" value="Disaster-risk theory &amp; DRR frameworks&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Sendai Framework · NDMP 2023–2030 · Pressure-and-Release (PAR) · GIS vulnerability mapping&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="110" width="260" height="110" as="geometry"/></mxCell><mxCell id="th2" value="Sociotechnical &amp; DSR design&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;sociotechnical systems theory · Design Science Research · design-actuality gap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="300" width="260" height="110" as="geometry"/></mxCell><mxCell id="ap1" value="Crowdsourced disaster systems&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Ushahidi (gov-integrated 3.4× impact) · ResQConnect (RAG, English-only) · DMC digital practice survey&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="900" y="110" width="260" height="110" as="geometry"/></mxCell><mxCell id="ap2" value="ML for disaster response&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;CNN/LSTM F1&gt;0.80 crisis tweets · RF/XGBoost top for structured DMC records · crowd-AI hybrids · XAI +20–35% trust&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="900" y="290" width="260" height="110" as="geometry"/></mxCell><mxCell id="ap3" value="NLP in crisis contexts&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;CrisisNLP / CrisisBench · RoBERTa macro-F1 0.79 · XLM-R low-resource · CRF location extraction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="900" y="470" width="260" height="110" as="geometry"/></mxCell><mxCell id="ap4" value="Offline-first for developing regions&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;94% vs 31% task completion offline · active learning −35–50% noise · dashboards −28% decision latency&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="650" width="260" height="110" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=none;html=1;fontSize=10;" edge="1" parent="1" source="th1" target="ctr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=none;html=1;fontSize=10;" edge="1" parent="1" source="th2" target="ctr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="endArrow=none;html=1;fontSize=10;" edge="1" parent="1" source="ap1" target="ctr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=none;html=1;fontSize=10;" edge="1" parent="1" source="ap2" target="ctr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="endArrow=none;html=1;fontSize=10;" edge="1" parent="1" source="ap3" target="ctr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="endArrow=none;html=1;fontSize=10;" edge="1" parent="1" source="ap4" target="ctr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="gaps" value="Research gaps that motivate Suraksha:&lt;br&gt;G1 no integrated multi-stakeholder architecture (SL)&lt;br&gt;G2 ML used post-event, not live uncertainty-aware triage&lt;br&gt;G3 no unified Sinhala–Tamil–English crisis NLP&lt;br&gt;G4 tools assume stable connectivity&lt;br&gt;G5 crowdsourcing not DMC-aligned" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="150" y="610" width="330" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>