<mxfile host="app.diagrams.net" version="24.7.5"><diagram name="C.1 Fragment 6" id="erf6"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Appendix C.1 — ER Fragment 6: Tokens and Donations   (crow's-foot · verified against schema.prisma)" style="text;html=1;fontStyle=1;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1040" height="24" as="geometry"/></mxCell><mxCell id="dc" value="&lt;b&gt;DonorCampaign&lt;/b&gt;&lt;hr size=&quot;1&quot; noshade&gt;PK id&lt;br&gt;donorName, contributionAmount&lt;br&gt;targetCategories : TokenCategory[]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="220" height="75" as="geometry"/></mxCell><mxCell id="rt" value="&lt;b&gt;ReliefToken&lt;/b&gt;&lt;hr size=&quot;1&quot; noshade&gt;PK id&lt;br&gt;code (U), qrCodeData&lt;br&gt;FK userId  → User&lt;br&gt;FK donorId?  → DonorCampaign&lt;br&gt;campId?  (soft — no FK)&lt;br&gt;status : TokenStatus, categories : TokenCategory[]&lt;br&gt;usageCount / maxUsage, fraudRiskScore" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="440" y="110" width="220" height="135" as="geometry"/></mxCell><mxCell id="rtc" value="&lt;b&gt;ReliefTokenClaim&lt;/b&gt;&lt;hr size=&quot;1&quot; noshade&gt;PK id&lt;br&gt;FK tokenId  → ReliefToken&lt;br&gt;claimedAt, claimedBy&lt;br&gt;itemType, quantity&lt;br&gt;locationLat?, locationLng?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="440" y="380" width="220" height="105" as="geometry"/></mxCell><mxCell id="dn" value="&lt;b&gt;Donation&lt;/b&gt;&lt;hr size=&quot;1&quot; noshade&gt;PK id&lt;br&gt;FK donorId?  → User&lt;br&gt;FK campId?  → ReliefCamp&lt;br&gt;type : DonationType, amount?&lt;br&gt;status : DonationStatus, transactionId?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="220" height="105" as="geometry"/></mxCell><mxCell id="r1" value="0..1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=ERone;endArrow=ERmany;startFill=0;endFill=0;" edge="1" parent="1" source="dc" target="rt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=ERone;endArrow=ERmany;startFill=0;endFill=0;" edge="1" parent="1" source="rt" target="rtc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nn3" value="ReliefToken.userId → User and Donation.donorId → User (Fragment 1); Donation.campId → ReliefCamp (Fragment 5)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="1040" height="42" as="geometry"/></mxCell><mxCell id="nn4" value="ReliefToken.campId is a soft reference (no foreign key)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="1040" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>