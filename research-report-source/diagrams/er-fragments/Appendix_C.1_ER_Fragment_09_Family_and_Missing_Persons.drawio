<mxfile host="app.diagrams.net" version="24.7.5"><diagram name="C.1 Fragment 9" id="erf9"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Appendix C.1 — ER Fragment 9: Family and Missing Persons   (crow's-foot · verified against schema.prisma)" style="text;html=1;fontStyle=1;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="970" height="24" as="geometry"/></mxCell><mxCell id="usr" value="&lt;b&gt;User&lt;/b&gt;  &lt;i&gt;(external)&lt;/i&gt;&lt;hr size=&quot;1&quot; noshade&gt;PK id  (see Fragment 1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="220" height="45" as="geometry"/></mxCell><mxCell id="fm" value="&lt;b&gt;FamilyMember&lt;/b&gt;&lt;hr size=&quot;1&quot; noshade&gt;PK id&lt;br&gt;FK primaryUserId  → User&lt;br&gt;name, relation, age?&lt;br&gt;status : SafetyStatus, phone?, notes?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="80" y="90" width="220" height="90" as="geometry"/></mxCell><mxCell id="sci" value="&lt;b&gt;SafetyCheckIn&lt;/b&gt;&lt;hr size=&quot;1&quot; noshade&gt;PK id&lt;br&gt;FK userId  → User&lt;br&gt;status : SafetyStatus, message?&lt;br&gt;latitude?, longitude?, createdAt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="220" height="90" as="geometry"/></mxCell><mxCell id="mp" value="&lt;b&gt;MissingPerson&lt;/b&gt;&lt;hr size=&quot;1&q