<mxfile host="app.diagrams.net" version="24.7.5"><diagram name="Fig 5.4 ALG-3 Flowchart" id="fig54"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Figure 5.4 — Flowchart: Severity Triage with Uncertainty Routing (Algorithm 3)" style="text;html=1;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="980" height="24" as="geometry"/></mxCell><mxCell id="s" value="START — incident feature vector x" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="300" y="56" width="310" height="44" as="geometry"/></mxCell><mxCell id="a1" value="Build the feature vector x  (12-dim)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="146" width="310" height="48" as="geometry"/></mxCell><mxCell id="a2" value="p_raw = xgb.predict_proba(x)[0]   — 4-class probabilities" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="236" width="310" height="54" as="geometry"/></mxCell><mxCell id="a3" value="Temperature-scale:  p = softmax(logit(p_raw) / T)   (T tuned on a held-out calibration set)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="332" width="310" height="60" as="geometry"/></mxCell><mxCell id="a4" value="severity = classes[argmax(p)] ;   confidence = max(p)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="434" width="310" height="52" as="geometry"/></mxCell><mxCell id="d1" value="confidence ≥ THRESHOLD  (≈ 0.73) ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="300" y="522" width="310" height="100" as="geometry"/></mxCell><mxCell id="auto" value="route = 'auto' — prediction accepted automatically; incident enters the normal officer queue" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720" y="536" width="270" height="72" as="geometry"/></mxCell><mxCell id="a5" value="route = 'human' — add incident to the human-review queue; notify officers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="664" width="310" height="58" as="geometry"/></mxCell><mxCell id="a6" value="Reviewing officer opens the incident (description + NLP entities + map)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="754" width="310" height="50" as="geometry"/></mxCell><mxCell id="d2" value="Officer agrees with the predicted severity ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="300" y="838" width="310" height="96" as="geometry"/></mxCell><mxCell id="conf" value="Confirm severity  (no change)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720" y="842" width="270" height="56" as="geometry"/></mxCell><mxCell id="corr" value="Officer sets the correct severity; add the corrected case to the active-learning re-annotation pool (future retraining)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720" y="936" width="270" height="84" as="geometry"/></mxCell><mxCell id="a7" value="Write the final severity to IncidentReport; append IncidentHistory" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="1000" width="310" height="58" as="geometry"/></mxCell><mxCell id="e" value="END" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="300" y="1094" width="310" height="44" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="s" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="a4" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="yes" style="exitX=1;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d1" target="auto"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="no" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d1" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="exitX=1;exitY=0.5;entryX=1;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="auto" target="e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="a6" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="yes" style="exitX=1;exitY=0.35;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d2" target="conf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="no" style="exitX=1;exitY=0.75;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="d2" target="corr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="exitX=0.5;exitY=1;entryX=0.75;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="conf" target="a7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="exitX=0.5;exitY=1;entryX=0.9;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="corr" target="a7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="a7" target="e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="THRESHOLD is tuned on a held-out calibration set, not the test set; under-triage (predicting a lower tier than the truth) is weighted as more costly than over-triage. This is the central algorithm for RO2 / RQ1. Reported metrics (Ch. 6): auto-coverage, error-capture rate, accepted accuracy." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="240" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>