<mxfile host="Electron">
  <diagram name="Fig 5.4 ALG-3 Flowchart" id="fig54">
    <mxGraphModel dx="860" dy="537" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" parent="1" style="text;html=1;fontStyle=1;fontSize=14;align=left;" value="Figure 5.4 — Flowchart: Severity Triage with Uncertainty Routing (Algorithm 3)" vertex="1">
          <mxGeometry height="24" width="980" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="s" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;" value="START — incident feature vector x" vertex="1">
          <mxGeometry height="44" width="310" x="300" y="56" as="geometry" />
        </mxCell>
        <mxCell id="a1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Build the feature vector x  (12-dim)" vertex="1">
          <mxGeometry height="48" width="310" x="300" y="146" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="p_raw = xgb.predict_proba(x)[0]   — 4-class probabilities" vertex="1">
          <mxGeometry height="54" width="310" x="300" y="236" as="geometry" />
        </mxCell>
        <mxCell id="a3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Temperature-scale:  p = softmax(logit(p_raw) / T)   (T tuned on a held-out calibration set)" vertex="1">
          <mxGeometry height="60" width="310" x="300" y="332" as="geometry" />
        </mxCell>
        <mxCell id="a4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="severity = classes[argmax(p)] ;   confidence = max(p)" vertex="1">
          <mxGeometry height="52" width="310" x="300" y="434" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;" value="confidence ≥ THRESHOLD  (≈ 0.73) ?" vertex="1">
          <mxGeometry height="100" width="310" x="300" y="522" as="geometry" />
        </mxCell>
        <mxCell id="auto" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="route = &#39;auto&#39; — prediction accepted automatically; incident enters the normal officer queue" vertex="1">
          <mxGeometry height="72" width="270" x="720" y="536" as="geometry" />
        </mxCell>
        <mxCell id="a5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="route = &#39;human&#39; — add incident to the human-review queue; notify officers" vertex="1">
