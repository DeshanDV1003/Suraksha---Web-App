        </mxCell>
        <mxCell id="d2" parent="1" style="rhombus;whiteSpace=wrap;html=1;" value="Officer agrees with the predicted severity ?" vertex="1">
          <mxGeometry height="96" width="310" x="300" y="838" as="geometry" />
        </mxCell>
        <mxCell id="conf" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Confirm severity  (no change)" vertex="1">
