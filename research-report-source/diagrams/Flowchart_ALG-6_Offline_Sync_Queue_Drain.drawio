<mxfile host="app.diagrams.net" version="24.7.5"><diagram name="Flowchart ALG-6" id="algc6"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1162" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Flowchart ALG-6 — Offline Sync Queue Drain (FIFO with bounded retry)" style="text;html=1;fontStyle=1;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="26" as="geometry"/></mxCell><mxCell id="s" value="START / trigger — connectivity restored · 8 s poll · app foreground · background task" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="280" height="54" as="geometry"/></mxCell><mxCell id="q1" value="online AND not already syncing ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="300" y="166" width="280" height="90" as="geometry"/></mxCell><mxCell id="end0" value="return (skip)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="600" y="120" width="280" height="54" as="geometry"/></mxCell><mxCell id="sel" value="SELECT * FROM sync_queue WHERE status='pending' AND attempts &lt; max ORDER BY created_at ASC  (FIFO)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="308" width="280" height="54" as="geometry"/></mxCell><mxCell id="lp" value="for each item: POST to SYNC_HANDLERS[type].endpoint  {X-Offline-Sync, X-Original-Timestamp}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="414" width="280" height="54" as="geometry"/></mxCell><mxCell id="q2" value="response 2xx ?" style="rhombus;whiteSpace=wrap;html=1;fi