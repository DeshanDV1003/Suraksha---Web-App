<mxfile host="app.diagrams.net" version="24.7.5"><diagram name="Fig 4.12 Class Diagram" id="fig412"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Figure 4.12 — Class Diagram: Incident, Alert and Water Subsystem (layered boundary → control → service → entity)" style="text;html=1;fontStyle=1;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1580" height="24" as="geometry"/></mxCell><mxCell id="auth" value="&lt;i&gt;«control»&lt;/i&gt;&lt;br&gt;&lt;b&gt;AuthMiddleware&lt;/b&gt;&lt;hr size=&quot;1&quot; noshade&gt;+ authMiddleware()&lt;br&gt;+ adminMiddleware()&lt;br&gt;+ officerMiddleware()&lt;br&gt;+ hospitalMiddleware()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="360" y="40" width="240" height="96" as="geometry"/></mxCell><mxCell id="ic" value="&lt;i&gt;«control»&lt;/i&gt;&lt;br&gt;&lt;b&gt;IncidentController&lt;/b&gt;&lt;hr size=&quot;1&quot; noshade&gt;+ createIncident(req,res)&lt;br&gt;+ getIncidents(req,res)&lt;br&gt;+ updateIncidentStatus()&lt;br&gt;+ deleteIncident()&lt;br&gt;+ triggerSOS()&lt;br&gt;+ resolveDuplicateLink()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="340" y="170" width="260" height="140" as="geometry"/></mxCell><mxCell id="ac" value="&lt;i&gt;«control»&lt;/i&gt;&lt;br&gt;&lt;b&gt;AlertController&lt;/b&gt;&lt;hr size=&quot;1&quot; noshade&gt;+ createAlert()&lt;br&gt;+ getAlerts()&lt;br&gt;+ deactivateAlert()&lt;br&gt;+ deleteAlert()&lt;br&gt;+ acknowledgeAlert()&lt;br&gt;+ getDeliveryStats()" style="rounded=0;whiteSpac