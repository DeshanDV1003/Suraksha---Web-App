<mxfile host="app.diagrams.net" version="24.7.5"><diagram name="Fig 5.1 Trilingual Pipeline (simple)" id="fig51simple"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Figure 5.1 — Trilingual Intake Pipeline (runs automatically on every incident report)" style="text;html=1;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1880" height="24" as="geometry"/></mxCell><mxCell id="si" value="Sinhala text" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="150" height="40" as="geometry"/></mxCell><mxCell id="ta" value="Tamil text" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="150" height="40" as="geometry"/></mxCell><mxCell id="en" value="English text" style="sketch=1;fontFamily=Comic Sans MS;strokeColor=#000000;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="195" width="150" height="40" as="geometry"/></mxCell><mxCell id="d1" value="1. Work out what
