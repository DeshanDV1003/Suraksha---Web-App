<mxfile host="app.diagrams.net" version="24.7.5"><diagram name="Fig 4.1 Architecture" id="fig41arch"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Figure 4.1 — System Architecture: Four-Layer Service-Oriented Architecture with External Integrations" style="text;html=1;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1280" height="26" as="geometry"/></mxCell><mxCell id="u_web" value="DMC Officer ·&lt;br&gt;Administrator ·&lt;br&gt;Hospital Staff" style="text;html=1;fontSize=10;align=right;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="150" height="60" as="geometry"/></mxCell><mxCell id="u_mob" value="Citizen ·&lt;br&gt;Volunteer ·&lt;br&gt;Field Responder" style="text;html=1;fontSize=10;align=right;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="30" y="175" width="150" height="60" as="geometry"/></mxCell><mxCell id="b1" value="PRESENTATION LAYER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;fontStyle=1;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="210" y="60" width="1090" height="160" as="geometry"/></mxCell><mxCell id="web" value="Web Dashboard — React 19 + Vite + Tailwind&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;DMC officers, administrators, hospital staff · Zustand · TanStack Query · React Router 7 · React Leaflet · i18next · Socket.IO client&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="240" y="100" width="505" height="100" as="geometry"/></mxCell><mxCell id="mob" value="Mobile App — Expo + React Native (offline-first)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;citizens, volunteers, responders · local SQLite queue + FIFO background sync · expo-location/camera/notifications · AsyncStorage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="770" y="100" width="500" height="100" as="geometry"/></mxCell><mxCell id="b2" value="APPLICATION LAYER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;fontStyle=1;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="210" y="250" width="1090" height="150" as="geometry"/></mxCell><mxCell id="api" value="Backend API — Node.js + Express + TypeScript (single service, :3001)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;user authentication + role-based access control · orchestrates ML-service API calls · scheduled jobs (hourly water &amp; rainfall ingestion, daily backup, escalation) · multi-channel alert dispatch · @turf district-zone lookup · Socket.IO server&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="240" y="285" width="1030" height="95" as="geometry"/></mxCell><mxCell id="b3" value="DATA LAYER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;fontStyle=1;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="210" y="430" width="520" height="160" as="geometry"/></mxCell><mxCell id="pg" value="PostgreSQL — single shared database&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;72 tables · 24 enums · UUID PKs · accessed via Prisma ORM · daily pg_dump backup&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="240" y="470" width="460" height="100" as="geometry"/></mxCell><mxCell id="b4" value="INTELLIGENCE LAYER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;fontStyle=1;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="770" y="430" width="530" height="160" as="geometry"/></mxCell><mxCell id="mlv" value="ML Microservice — Python FastAPI&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;22 API endpoints · 16 ML/AI components · 5 genuinely trained (severity XGBoost, LSTM river, spaCy NER, credibility XGBoost, spatiotemporal GB) · rest analytical / rule-based / pre-trained&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="800" y="470" width="470" height="100" as="geometry"/></mxCell><mxCell id="b5" value="EXTERNAL INTEGRATIONS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;fontStyle=1;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="210" y="620" width="1090" height="95" as="geometry"/></mxCell><mxCell id="x1" value="Twilio&lt;br&gt;(SMS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="240" y="655" width="140" height="48" as="geometry"/></mxCell><mxCell id="x2" value="Nodemailer&lt;br&gt;(e-mail)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="390" y="655" width="140" height="48" as="geometry"/></mxCell><mxCell id="x3" value="Expo&lt;br&gt;(push)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="540" y="655" width="140" height="48" as="geometry"/></mxCell><mxCell id="x4" value="Telegram&lt;br&gt;Bot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="690" y="655" width="140" height="48" as="geometry"/></mxCell><mxCell id="x5" value="Open-Meteo&lt;br&gt;(rainfall)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="840" y="655" width="140" height="48" as="geometry"/></mxCell><mxCell id="x6" value="Nominatim&lt;br&gt;(geocoding)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="990" y="655" width="140" height="48" as="geometry"/></mxCell><mxCell id="x7" value="Google&lt;br&gt;OAuth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1140" y="655" width="140" height="48" as="geometry"/></mxCell><mxCell id="e8" value="" style="endArrow=none;html=1;fontSize=10;" edge="1" parent="1" source="u_web" target="web"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="endArrow=none;html=1;fontSize=10;" edge="1" parent="1" source="u_mob" target="mob"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="REST (JWT) + Socket.IO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="web" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="REST (JWT, via ngrok) + Socket.IO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="mob" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="Prisma ORM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="api" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="HTTP (JSON)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="api" target="mlv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="best-effort fan-out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="api" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="Open-Meteo pull" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="mlv" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="deg" value="Graceful degradation: if the ML service is unavailable, AI-only endpoints return an explicit error (HTTP 503) rather than hanging, and GET /api/water/predictions keeps serving the most recently cached WaterLevelPrediction row — the command dashboard never goes dark." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="210" y="745" width="1090" height="60" as="geometry"/></mxCell><mxCell id="dep" value="Evaluated topology: all four tiers on one workstation (PostgreSQL :5432, backend :3001, web dev :5173, ML :8000); mobile reaches the backend + Socket.IO via two static ngrok tunnels. Production (future work): backend + ML behind a reverse proxy, managed PostgreSQL, web as CDN static assets." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="210" y="815" width="1090" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>