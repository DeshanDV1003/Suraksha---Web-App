<mxfile host="app.diagrams.net" version="24.7.5"><diagram name="Flowchart ALG-4" id="algc4"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1304" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Flowchart ALG-4 — Incident Duplicate Detection (weighted additive scoring)" style="text;html=1;fontStyle=1;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="26" as="geometry"/></mxCell><mxCell id="s" value="START — new incident created" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="280" height="54" as="geometry"/></mxCell><mxCell id="fc" value="fetch candidates: same category, &lt; 6 h old, not RESOLVED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="166" width="280" height="54" as="geometry"/></mxCell><mxCell id="lp" value="for each candidate: score = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="272" width="280" height="54" as="geometry"/></mxCell><mxCell id="q1" value="both have coordinates AND distance ≤ 1000 m ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="300" y="378" width="280" height="90" as="geometry"/></mxCell><mxCell id="loc" value="score += 40 × (1 − d/1000)   [LOCATION]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="600" y="250" width="280" height="54" as="geometry"/></mxCell><mxCell id="cat" value="score += 30   [CATEGORY — always, candidates already filtered]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="520" width="280" height="54" as="geometry"/></mxCell><mxCell id="q2" value="|Δt| ≤ 6 h ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="300" y="626" width="280" height="90" as="geometry"/></mxCell><mxCell id="tim" value="score += 20 × (1 − Δt/6h)   [TIME]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="600" y="470" width="280" height="54" as="geometry"/></mxCell><mxCell id="q3" value="NLP entity-text overlap &gt; 0 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="300" y="768" width="280" height="90" as="geometry"/></mxCell><mxCell id="nlp" value="score += 10 × overlap   [NLP]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="600" y="620" width="280" height="54" as="geometry"/></mxCell><mxCell id="q4" value="score ≥ 50 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="300" y="910" width="280" height="90" as="geometry"/></mxCell><mxCell id="mk" value="create IncidentDuplicateLink (older = canonical, PENDING); officer confirms / dismisses" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="600" y="770" width="280" height="54" as="geometry"/></mxCell><mxCell id="nx" value="next candidate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="1052" width="280" height="54" as="geometry"/></mxCell><mxCell id="e" value="END  (fire-and-forget — never blocks the create response)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="300" y="1158" width="280" height="54" as="geometry"/></mxCell><mxCell id="e1" value=