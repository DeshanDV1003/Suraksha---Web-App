<mxfile host="app.diagrams.net" version="24.7.5"><diagram name="Figure 5.1" id="fig51"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1090" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Figure 5.1 — NLP Pipeline: Trilingual Intake Processing (/process-report)" style="text;html=1;fontStyle=1;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="26" as="geometry"/></mxCell><mxCell id="s" value="START — raw citizen report text" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="280" height="54" as="geometry"/></mxCell><mxCell id="ld" value="detect_language()  — Unicode-script check → Sinhala/Tamil/English word-list → langdetect / langid cascade" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="166" width="280" height="54" as="geometry"/></mxCell><mxCell id="q1" value="language == English ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="300" y="272" width="280" height="90" as="geometry"/></mxCell><mxCell id="tr" value="translate_to_english()  — library NMT (Si/Ta → En)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="620" y="250" width="280" height="54" as="geometry"/></mxCell><mxCell id="ner" value="extract_entities()  — spaCy neural NER (trained v2.2) + regex/gazetteer fallback → {LOC, INCIDENT, COUNT, DATE, DAMAGE}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="414" width="280" height="54" as="geometry"/></mxCell><mxCell id="fv" value="build_feature_vector()  — affected population, hazard 